#!/usr/bin/env sh

set -eu

commit_msg_file="$1"
commit_subject="$(head -n 1 "$commit_msg_file")"

# Allow merge commits created by Git.
case "$commit_subject" in
  Merge\ *|Revert\ * )
    exit 0
    ;;
esac

# Conventional Commit (basic): type(scope)!: description
# Scope and breaking (!) are optional.
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|deps)(\([^)]+\))?(!)?: .+$'

if printf '%s\n' "$commit_subject" | grep -Eq "$pattern"; then
  exit 0
fi

printf '%s\n' "ERROR: Invalid commit message." 1>&2
printf '%s\n' "" 1>&2
printf '%s\n' "Expected: type(scope)!: description" 1>&2
printf '%s\n' "Examples:" 1>&2
printf '%s\n' "  feat: add note editor" 1>&2
printf '%s\n' "  fix(storage): handle missing key" 1>&2
printf '%s\n' "  refactor!: drop legacy API" 1>&2
printf '%s\n' "" 1>&2
printf '%s\n' "Actual:" 1>&2
printf '%s\n' "  $commit_subject" 1>&2
exit 1
